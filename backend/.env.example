NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_spare_parts_erp
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
# Optional if pg_dump is not available in PATH:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# Optional if pg_restore is not available in PATH:
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe

# Optional. Use these with a mounted Railway volume for persistent files.
# UPLOAD_ROOT=/data/uploads
# BACKUP_DIR=/data/backups
