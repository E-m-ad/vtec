NODE_ENV=production
PORT=5000
HOST=0.0.0.0
SERVE_FRONTEND=true

# The backend runs on the center computer, so the app connects to local PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vtec

# Replace this with a long random secret before real use.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Leave empty when the backend serves the frontend on the same port.
# Add comma-separated origins only if a separate frontend will call the API.
CORS_ORIGIN=

# Optional if PostgreSQL tools are not available in PATH:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
