generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  cashier
  inventory
  service_receptionist
  service_advisor
  service_technician
  parts_clerk
  qc_inspector
  delivery_coordinator
}

enum PaymentStatus {
  paid
  partial
  unpaid
  refunded
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  SALE_RETURN
  PURCHASE_RETURN
}

enum InventoryCountStatus {
  counting
  reviewed
  outdated
  applied
  cancelled
}

enum EmployeeStatus {
  active
  inactive
  on_leave
  terminated
}

enum EmployeeSalaryTransactionType {
  salary_payment
  advance
  deduction
  bonus
  allowance
}

enum AttendanceStatus {
  present
  absent
}

enum ServiceJobStatus {
  RECEIVED
  AWAITING_DIAGNOSIS
  DIAGNOSIS_IN_PROGRESS
  DIAGNOSIS_DONE
  ESTIMATE_CREATED
  AWAITING_APPROVAL
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  WAITING_PARTS
  WORK_IN_PROGRESS
  WORK_DONE
  QC_IN_PROGRESS
  QC_FAILED
  QC_PASSED
  READY_FOR_INVOICE
  INVOICED
  PAYMENT_PENDING
  PAID
  READY_FOR_DELIVERY
  DELIVERED
  CLOSED
  CANCELLED
}

enum InvoiceLineType {
  product
  service
}

enum ServiceEstimateStatus {
  draft
  sent
  approved
  partially_approved
  rejected
}

enum ServiceLineApprovalStatus {
  pending
  approved
  rejected
}

enum ServiceWorkOrderStatus {
  pending
  in_progress
  done
  cancelled
}

enum ServiceWorkLineStatus {
  pending
  in_progress
  done
  rework
  cancelled
}

enum ServicePartRequestStatus {
  requested
  reserved
  issued
  unavailable
  returned
}

enum ServiceApprovalMethod {
  paper_signature
  phone
  whatsapp
  sms
  email
  system
}

enum ServiceCustomerApprovalStatus {
  approved
  partially_approved
  rejected
}

enum SupplierOpeningBalanceType {
  payable
  credit
}

enum CustomerOpeningBalanceType {
  receivable
  credit
}

enum SupplierRefundType {
  credit_note
  cash_refund
}

model User {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @db.VarChar(120)
  email                       String                      @unique @db.VarChar(160)
  passwordHash                String                      @map("password_hash")
  role                        UserRole                    @default(cashier)
  isActive                    Boolean                     @default(true) @map("is_active")
  permissionsCustomized       Boolean                     @default(false) @map("permissions_customized")
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userPermissions             UserPermission[]
  purchases                   Purchase[]                  @relation("PurchaseCreator")
  sales                       Sale[]                      @relation("SaleCreator")
  saleReturns                 SaleReturn[]                @relation("SaleReturnCreator")
  purchaseReturns             PurchaseReturn[]            @relation("PurchaseReturnCreator")
  customerRefunds             CustomerRefund[]            @relation("CustomerRefundCreator")
  supplierRefunds             SupplierRefund[]            @relation("SupplierRefundCreator")
  stockMovements              StockMovement[]             @relation("StockMovementCreator")
  inventoryCountSessions      InventoryCountSession[]     @relation("InventoryCountSessionCreator")
  inventoryCountItems         InventoryCountItem[]        @relation("InventoryCountItemCounter")
  supplierPayments            SupplierPayment[]           @relation("SupplierPaymentCreator")
  employeeSalaryTransactions  EmployeeSalaryTransaction[] @relation("EmployeeSalaryTransactionCreator")
  employeeAttendances         EmployeeAttendance[]        @relation("EmployeeAttendanceCreator")
  generalExpenses             GeneralExpense[]            @relation("GeneralExpenseCreator")
  salePayments                SalePayment[]               @relation("SalePaymentCreator")
  customerPayments            CustomerPayment[]           @relation("CustomerPaymentCreator")
  serviceJobs                 ServiceJob[]                @relation("ServiceJobCreator")
  serviceAdvisorJobs          ServiceJob[]                @relation("ServiceJobAdvisor")
  serviceTechnicianJobs       ServiceJob[]                @relation("ServiceJobTechnician")
  serviceJobItems             ServiceJobItem[]            @relation("ServiceJobItemCreator")
  serviceJobPayments          ServiceJobPayment[]         @relation("ServiceJobPaymentCreator")
  serviceJobComplaints        ServiceJobComplaint[]       @relation("ServiceJobComplaintCreator")
  serviceCheckInInspections   ServiceCheckInInspection[]  @relation("ServiceCheckInInspectionCreator")
  serviceDiagnosisReports     ServiceDiagnosisReport[]    @relation("ServiceDiagnosisReportCreator")
  serviceDiagnosisAssignments ServiceDiagnosisReport[]    @relation("ServiceDiagnosisTechnician")
  serviceEstimates            ServiceEstimate[]           @relation("ServiceEstimateCreator")
  serviceCustomerApprovals    ServiceCustomerApproval[]   @relation("ServiceCustomerApprovalCreator")
  serviceWorkOrders           ServiceWorkOrder[]          @relation("ServiceWorkOrderCreator")
  serviceWorkOrderLines       ServiceWorkOrderLine[]      @relation("ServiceWorkOrderLineCreator")
  serviceWorkLineAssignments  ServiceWorkOrderLine[]      @relation("ServiceWorkOrderLineTechnician")
  servicePartRequests         ServicePartRequest[]        @relation("ServicePartRequestCreator")
  serviceQCReports            ServiceQCReport[]           @relation("ServiceQCReportCreator")
  serviceDeliveryHandovers    ServiceDeliveryHandover[]   @relation("ServiceDeliveryHandoverCreator")
  serviceJobHistories         ServiceJobHistory[]         @relation("ServiceJobHistoryPerformer")
  supplierProductSettlements  SupplierProductSettlement[] @relation("SupplierProductSettlementCreator")
  supplierLegacyWorkbooks     SupplierLegacyWorkbook[]    @relation("SupplierLegacyWorkbookUploader")
  supplierOpeningBalances     SupplierOpeningBalance[]    @relation("SupplierOpeningBalanceCreator")
  customerOpeningBalances     CustomerOpeningBalance[]    @relation("CustomerOpeningBalanceCreator")

  @@map("users")
}

model UserPermission {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  permission String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
  @@map("user_permissions")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("brands")
}

model Supplier {
  id                 Int                         @id @default(autoincrement())
  name               String                      @unique @db.VarChar(160)
  contactName        String?                     @map("contact_name") @db.VarChar(120)
  phone              String?                     @unique @db.VarChar(40)
  email              String?                     @unique @db.VarChar(160)
  address            String?
  taxNumber          String?                     @map("tax_number") @db.VarChar(80)
  notes              String?
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  products           Product[]
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  payments           SupplierPayment[]
  productSettlements SupplierProductSettlement[]
  legacyWorkbooks    SupplierLegacyWorkbook[]
  openingBalances    SupplierOpeningBalance[]
  refunds            SupplierRefund[]

  @@map("suppliers")
}

model SupplierOpeningBalance {
  id          Int                        @id @default(autoincrement())
  supplierId  Int                        @map("supplier_id")
  type        SupplierOpeningBalanceType @default(payable)
  amount      Decimal                    @db.Decimal(12, 2)
  balanceDate DateTime                   @default(now()) @map("balance_date") @db.Timestamptz(3)
  notes       String?
  createdBy   Int?                       @map("created_by")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  supplier    Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator     User?                      @relation("SupplierOpeningBalanceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([balanceDate])
  @@index([type])
  @@map("supplier_opening_balances")
}

model SupplierLegacyWorkbook {
  id               Int       @id @default(autoincrement())
  supplierId       Int       @map("supplier_id")
  originalFileName String    @map("original_file_name") @db.VarChar(255)
  storedFileName   String    @unique @map("stored_file_name") @db.VarChar(255)
  fileSizeBytes    Int       @map("file_size_bytes")
  checksumSha256   String    @map("checksum_sha256") @db.VarChar(64)
  sheetCount       Int       @default(0) @map("sheet_count")
  uploadedBy       Int?      @map("uploaded_by")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  uploader         User?     @relation("SupplierLegacyWorkbookUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([uploadedAt])
  @@index([deletedAt])
  @@map("supplier_legacy_workbooks")
}

model Customer {
  id              Int                      @id @default(autoincrement())
  name            String                   @db.VarChar(160)
  phone           String?                  @db.VarChar(40)
  email           String?                  @db.VarChar(160)
  address         String?
  taxNumber       String?                  @map("tax_number") @db.VarChar(80)
  notes           String?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales           Sale[]
  saleReturns     SaleReturn[]
  refunds         CustomerRefund[]
  cars            Car[]
  serviceJobs     ServiceJob[]
  payments        CustomerPayment[]
  openingBalances CustomerOpeningBalance[]

  @@map("customers")
}

model CustomerOpeningBalance {
  id          Int                        @id @default(autoincrement())
  customerId  Int                        @map("customer_id")
  type        CustomerOpeningBalanceType @default(receivable)
  amount      Decimal                    @db.Decimal(12, 2)
  balanceDate DateTime                   @default(now()) @map("balance_date") @db.Timestamptz(3)
  notes       String?
  createdBy   Int?                       @map("created_by")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  customer    Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator     User?                      @relation("CustomerOpeningBalanceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([balanceDate])
  @@index([type])
  @@map("customer_opening_balances")
}

model CustomerPayment {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Timestamptz(3)
  paymentMethod String?  @map("payment_method") @db.VarChar(60)
  notes         String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator       User?    @relation("CustomerPaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([paymentDate])
  @@map("customer_payments")
}

model Car {
  id          Int          @id @default(autoincrement())
  customerId  Int?         @map("customer_id")
  plateNumber String?      @unique @map("plate_number") @db.VarChar(40)
  vin         String?      @unique @db.VarChar(80)
  make        String       @db.VarChar(120)
  model       String       @db.VarChar(120)
  year        Int?
  color       String?      @db.VarChar(80)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sales       Sale[]
  serviceJobs ServiceJob[]

  @@index([customerId])
  @@index([make, model])
  @@map("cars")
}

model Employee {
  id                 Int                         @id @default(autoincrement())
  employeeCode       String?                     @unique @map("employee_code") @db.VarChar(80)
  name               String                      @db.VarChar(160)
  phone              String?                     @unique @db.VarChar(40)
  email              String?                     @unique @db.VarChar(160)
  address            String?
  position           String?                     @db.VarChar(120)
  department         String?                     @db.VarChar(120)
  salary             Decimal?                    @db.Decimal(12, 2)
  hireDate           DateTime?                   @map("hire_date") @db.Date
  status             EmployeeStatus              @default(active)
  attendanceToken    String?                     @unique @map("attendance_token") @db.VarChar(120)
  notes              String?
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  salaryTransactions EmployeeSalaryTransaction[]
  attendanceRecords  EmployeeAttendance[]

  @@index([name])
  @@index([status])
  @@map("employees")
}

model EmployeeSalaryTransaction {
  id                  Int                           @id @default(autoincrement())
  employeeId          Int                           @map("employee_id")
  type                EmployeeSalaryTransactionType
  amount              Decimal                       @db.Decimal(12, 2)
  transactionDate     DateTime                      @default(now()) @map("transaction_date") @db.Timestamptz(3)
  paymentMethod       String?                       @map("payment_method") @db.VarChar(60)
  notes               String?
  createdBy           Int?                          @map("created_by")
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  employee            Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  creator             User?                         @relation("EmployeeSalaryTransactionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  attendanceDeduction EmployeeAttendance?           @relation("AttendanceDeduction")

  @@index([employeeId])
  @@index([transactionDate])
  @@index([type])
  @@map("employee_salary_transactions")
}

model EmployeeAttendance {
  id                     Int                        @id @default(autoincrement())
  employeeId             Int                        @map("employee_id")
  attendanceDate         DateTime                   @map("attendance_date") @db.Date
  status                 AttendanceStatus
  checkInAt              DateTime?                  @map("check_in_at") @db.Timestamptz(3)
  deductionAmount        Decimal?                   @map("deduction_amount") @db.Decimal(12, 2)
  deductionTransactionId Int?                       @unique @map("deduction_transaction_id")
  notes                  String?
  finalized              Boolean                    @default(false)
  createdBy              Int?                       @map("created_by")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  employee               Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deductionTransaction   EmployeeSalaryTransaction? @relation("AttendanceDeduction", fields: [deductionTransactionId], references: [id], onDelete: SetNull)
  creator                User?                      @relation("EmployeeAttendanceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([status])
  @@index([finalized])
  @@map("employee_attendance")
}

model GeneralExpense {
  id            Int      @id @default(autoincrement())
  category      String   @db.VarChar(120)
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @default(now()) @map("expense_date") @db.Timestamptz(3)
  paymentMethod String?  @map("payment_method") @db.VarChar(60)
  notes         String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  creator       User?    @relation("GeneralExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@map("general_expenses")
}

model Product {
  id                         Int                         @id @default(autoincrement())
  sku                        String                      @unique @db.VarChar(80)
  barcode                    String?                     @unique @db.VarChar(120)
  name                       String                      @db.VarChar(180)
  description                String?
  categoryId                 Int?                        @map("category_id")
  brandId                    Int?                        @map("brand_id")
  supplierId                 Int?                        @map("supplier_id")
  purchasePrice              Decimal                     @default(0) @map("purchase_price") @db.Decimal(12, 2)
  salePrice                  Decimal                     @default(0) @map("sale_price") @db.Decimal(12, 2)
  stockQuantity              Int                         @default(0) @map("stock_quantity")
  minStockLevel              Int                         @default(0) @map("min_stock_level")
  location                   String?                     @db.VarChar(120)
  isActive                   Boolean                     @default(true) @map("is_active")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  category                   Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                      Brand?                      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier                   Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseItems              PurchaseItem[]
  saleItems                  SaleItem[]
  saleReturnItems            SaleReturnItem[]
  purchaseReturnItems        PurchaseReturnItem[]
  serviceJobItems            ServiceJobItem[]
  serviceEstimateLines       ServiceEstimateLine[]
  servicePartRequests        ServicePartRequest[]
  stockMovements             StockMovement[]
  inventoryCountItems        InventoryCountItem[]
  supplierProductSettlements SupplierProductSettlement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@map("products")
}

model InventoryCountSession {
  id          Int                  @id @default(autoincrement())
  countNumber String               @unique @map("count_number") @db.VarChar(120)
  status      InventoryCountStatus @default(counting)
  scopeType   String               @default("all") @map("scope_type") @db.VarChar(60)
  scopeValue  String?              @map("scope_value") @db.VarChar(160)
  startedAt   DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  reviewedAt  DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  appliedAt   DateTime?            @map("applied_at") @db.Timestamptz(3)
  notes       String?
  createdBy   Int?                 @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator     User?                @relation("InventoryCountSessionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items       InventoryCountItem[]

  @@index([status])
  @@index([startedAt])
  @@map("inventory_count_sessions")
}

model InventoryCountItem {
  id                     Int                   @id @default(autoincrement())
  sessionId              Int                   @map("session_id")
  productId              Int                   @map("product_id")
  systemQuantitySnapshot Int                   @default(0) @map("system_quantity_snapshot")
  countedQuantity        Int                   @default(0) @map("counted_quantity")
  scannedCount           Int                   @default(0) @map("scanned_count")
  isCounted              Boolean               @default(false) @map("is_counted")
  unitCost               Decimal               @default(0) @map("unit_cost") @db.Decimal(12, 2)
  addedFromScan          Boolean               @default(false) @map("added_from_scan")
  lastScannedAt          DateTime?             @map("last_scanned_at") @db.Timestamptz(3)
  notes                  String?
  countedBy              Int?                  @map("counted_by")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  session                InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product                Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  counter                User?                 @relation("InventoryCountItemCounter", fields: [countedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
  @@index([isCounted])
  @@map("inventory_count_items")
}

model Purchase {
  id                           Int                                   @id @default(autoincrement())
  supplierId                   Int?                                  @map("supplier_id")
  invoiceNumber                String?                               @map("invoice_number") @db.VarChar(120)
  purchaseDate                 DateTime                              @default(now()) @map("purchase_date") @db.Timestamptz(3)
  totalAmount                  Decimal                               @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes                        String?
  createdBy                    Int?                                  @map("created_by")
  createdAt                    DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier                     Supplier?                             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator                      User?                                 @relation("PurchaseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items                        PurchaseItem[]
  payments                     SupplierPayment[]
  returns                      PurchaseReturn[]
  refunds                      SupplierRefund[]
  productSettlements           SupplierProductSettlement[]
  productSettlementAllocations SupplierProductSettlementAllocation[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id          Int                  @id @default(autoincrement())
  purchaseId  Int                  @map("purchase_id")
  productId   Int                  @map("product_id")
  quantity    Int
  unitCost    Decimal              @map("unit_cost") @db.Decimal(12, 2)
  lineTotal   Decimal              @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems PurchaseReturnItem[]

  @@map("purchase_items")
}

model PurchaseReturn {
  id           Int                  @id @default(autoincrement())
  purchaseId   Int                  @map("purchase_id")
  supplierId   Int?                 @map("supplier_id")
  returnNumber String               @unique @map("return_number") @db.VarChar(120)
  returnDate   DateTime             @default(now()) @map("return_date") @db.Timestamptz(3)
  totalAmount  Decimal              @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes        String?
  createdBy    Int?                 @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplier     Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator      User?                @relation("PurchaseReturnCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items        PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([returnDate])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int            @map("purchase_return_id")
  purchaseItemId   Int            @map("purchase_item_id")
  productId        Int            @map("product_id")
  quantity         Int
  unitCost         Decimal        @map("unit_cost") @db.Decimal(12, 2)
  lineTotal        Decimal        @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@index([productId])
  @@map("purchase_return_items")
