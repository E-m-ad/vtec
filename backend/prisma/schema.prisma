  @@index([status])
  @@map("service_part_requests")
}

model ServiceQCReport {
  id               Int        @id @default(autoincrement())
  jobId            Int        @map("job_id")
  complaintSolved  Boolean    @default(false) @map("complaint_solved")
  roadTestDone     Boolean    @default(false) @map("road_test_done")
  scannerCheckDone Boolean    @default(false) @map("scanner_check_done")
  leaksChecked     Boolean    @default(false) @map("leaks_checked")
  passed           Boolean    @default(false)
  finalNotes       String?    @map("final_notes")
  createdBy        Int?       @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  job              ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creator          User?      @relation("ServiceQCReportCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([passed])
  @@map("service_qc_reports")
}

model ServiceDeliveryHandover {
  id             Int        @id @default(autoincrement())
  jobId          Int        @map("job_id")
  deliveredBy    Int?       @map("delivered_by")
  receivedByName String?    @map("received_by_name") @db.VarChar(160)
  customerSigned Boolean    @default(false) @map("customer_signed")
  deliveredAt    DateTime   @default(now()) @map("delivered_at") @db.Timestamptz(3)
  notes          String?
  createdBy      Int?       @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  job            ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creator        User?      @relation("ServiceDeliveryHandoverCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([deliveredAt])
  @@map("service_delivery_handovers")
}

model ServiceJobHistory {
  id          Int               @id @default(autoincrement())
  jobId       Int               @map("job_id")
  fromStatus  ServiceJobStatus? @map("from_status")
  toStatus    ServiceJobStatus? @map("to_status")
  action      String            @db.VarChar(120)
  performedBy Int?              @map("performed_by")
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  job         ServiceJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  performer   User?             @relation("ServiceJobHistoryPerformer", fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdAt])
  @@map("service_job_history")
}

model StockMovement {
  id               Int               @id @default(autoincrement())
  productId        Int               @map("product_id")
  movementType     StockMovementType @map("movement_type")
  quantity         Int
  previousQuantity Int               @map("previous_quantity")
  newQuantity      Int               @map("new_quantity")
  referenceType    String?           @map("reference_type") @db.VarChar(80)
  referenceId      Int?              @map("reference_id")
  notes            String?
  createdBy        Int?              @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator          User?             @relation("StockMovementCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}
